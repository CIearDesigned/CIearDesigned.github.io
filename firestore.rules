rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validCurrency(data) {
      return data.acceptedCurrencies is list
        && data.acceptedCurrencies.size() >= 1
        && data.acceptedCurrencies.size() <= 2
        && data.acceptedCurrencies.hasOnly(['robux', 'usd'])
        && (('robux' in data.acceptedCurrencies) == (data.priceRobux is number && data.priceRobux > 0))
        && (('usd' in data.acceptedCurrencies) == (data.priceUsd is number && data.priceUsd > 0));
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.robloxUsername is string
        && request.resource.data.robloxUsername.size() >= 3
        && request.resource.data.robloxUsername.size() <= 20;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['robloxUsername', 'robloxUrl', 'updatedAt']);
      allow delete: if false;
    }
    match /gameListings/{listingId} {
      allow read: if resource.data.status == 'active' || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 5000
        && request.resource.data.genre in ['Obby', 'Tycoon', 'Simulator', 'RPG', 'FPS', 'Horror', 'Other']
        && request.resource.data.assetType in ['rbxl', 'ownership', 'system']
        && validCurrency(request.resource.data);
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && validCurrency(request.resource.data);
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/gameListings/$(listingId)).data.status == 'active';
        allow create: if signedIn()
          && get(/databases/$(database)/documents/gameListings/$(listingId)).data.status == 'active'
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 2000;
        allow update: if false;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
